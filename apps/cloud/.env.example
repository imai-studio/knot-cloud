APP_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
# Optional until the isolated public reader is enabled. In production this must
# use a separate registrable domain from APP_BASE_URL.
CONTENT_BASE_URL=http://localhost:3001
AUTH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-separate-32-character-random-secret
DATABASE_URL=postgres://knot_app:replace-me@localhost:5432/knot
API_KEY_PEPPER=replace-with-at-least-32-random-characters
API_KEY_PEPPER_VERSION=1
IDENTITY_DIGEST_PEPPER=replace-with-at-least-32-random-characters
IDENTITY_DIGEST_VERSION=1
# Optional. Transactional channel event delivery stays unavailable until at
# least one fixed HTTPS destination is configured by name.
WEBHOOK_DESTINATIONS_JSON={"automation":{"url":"https://hooks.example.com/knot/events","secret":"replace-with-at-least-32-random-characters"}}
WEBHOOK_MAX_ACTIVE_SUBSCRIPTIONS=50
# Optional. Custom-domain creation and TXT verification stay unavailable until
# this independent secret is configured.
DOMAIN_CHALLENGE_SECRET=replace-with-a-separate-32-character-random-secret

EMAIL_FROM=Knot <access@example.com>
KNOT_ALLOWED_EMAILS=operator@example.com
RESEND_API_KEY=replace-me

OBJECT_STORE_DRIVER=r2
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=knot-private
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_MAX_OBJECT_BYTES=104857600

# Add these only when a replay-protected route is released.
REPLAY_STORE_DRIVER=upstash
# Explicit Upstash names are preferred when set.
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# Vercel's official Upstash integration injects these names instead. Use this
# complete pair only when the explicit UPSTASH_* pair above is absent.
# KV_REST_API_URL=https://replace-me.upstash.io
# KV_REST_API_TOKEN=replace-me
